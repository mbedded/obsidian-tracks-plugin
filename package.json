{
  "name": "web-task-dashboard",
  "version": "1.0.1",
  "description": "Integrates your tasks from web services into Obsidian, allowing you to stay in Obsidian without distraction.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "svelte-check": "svelte-check --tsconfig tsconfig.json",
    "test": "jest",
    "test:ci": "CI_BUILD=true jest"
  },
  "keywords": [],
  "author": "mbedded",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@jest/globals": "30.4.1",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "babel-jest": "30.4.1",
    "builtin-modules": "5.2.0",
    "esbuild": "0.28.0",
    "esbuild-svelte": "0.9.5",
    "fast-xml-parser": "5.8.0",
    "jest": "30.4.2",
    "obsidian": "1.12.3",
    "svelte": "5.55.10",
    "svelte-check": "4.4.8",
    "svelte-preprocess": "6.0.5",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  }
}
