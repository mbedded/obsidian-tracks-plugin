{
  "name": "web-task-dashboard",
  "version": "1.0.1",
  "description": "Integrates your tasks from web services into Obsidian, allowing you to stay in Obsidian without distraction.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "svelte-check": "svelte-check --tsconfig tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --tags-filter=\"!integration\""
  },
  "keywords": [],
  "author": "mbedded",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "builtin-modules": "5.3.0",
    "esbuild": "0.28.1",
    "esbuild-svelte": "0.9.5",
    "fast-xml-parser": "5.10.1",
    "obsidian": "1.13.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "svelte-preprocess": "6.0.5",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
