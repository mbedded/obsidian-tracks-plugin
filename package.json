{
  "name": "web-task-dashboard",
  "version": "1.0.1",
  "description": "Integrates your tasks from web services into Obsidian, allowing you to stay in Obsidian without distraction.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "svelte-check": "svelte-check --tsconfig tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --tags-filter=\"!integration\""
  },
  "keywords": [],
  "author": "mbedded",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-typescript": "7.29.7",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "builtin-modules": "5.0.0",
    "esbuild": "0.25.9",
    "esbuild-svelte": "0.9.5",
    "fast-xml-parser": "5.3.6",
    "obsidian": "1.11.4",
    "svelte": "5.55.9",
    "svelte-check": "4.4.0",
    "svelte-preprocess": "6.0.5",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
